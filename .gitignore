agent_backend/reports/*.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!agent_backend/.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
