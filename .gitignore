# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
.idea/
**/.idea/

# Python TrendScope agent
agent_backend/.venv/
agent_backend/.env
agent_backend/__pycache__/
