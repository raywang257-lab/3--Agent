# 首次运行保持 rules，不需要 OpenAI Key。
# 配置好 OPENAI_API_KEY 后改成 openai，启用结构化 AI 分析。
AI_MODE=rules
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.exchangetoken.ai/v1
OPENAI_API_STYLE=chat_completions
OPENAI_MODEL=gpt-5.4

# GitHub Token 可选；不填也能运行，但匿名 API 限额更低。
GITHUB_TOKEN=

# 多个 RSS 地址使用英文逗号分隔；留空时只运行 GitHub 和 Hacker News。
RSS_FEEDS=

DATABASE_PATH=data/trendscope.db
REPORT_DIR=reports
SCHEDULE_ENABLED=false
SCHEDULE_MINUTES=60
MAX_ITEMS_PER_SOURCE=20
REQUEST_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# 邮件推送：只发送人工确认通过的热点
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
EMAIL_RECIPIENTS=
